{
  "name": "dsh-offerloop",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "OfferLoop 求职台：目标 JD → 简历版本 → 模拟面试（随机出题 + 打分）→ 复盘。DeepSeek Harness 持久化插件。",
  "keywords": ["dsh", "deepseek-harness", "plugin", "job-search", "interview", "resume"],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}